generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ANALYST
  USER
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BONUS_CREDIT
  BONUS_WITHDRAWAL
  BONUS_TRANSFER
  INTERNAL_TRANSFER_OUT
  INTERNAL_TRANSFER_IN
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              UserRole  @default(USER)
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(true)
  otp               String?
  otpExpiry         DateTime?
  phoneOtp          String?
  phoneOtpExpiry    DateTime?
  resetToken        String?
  resetExpiry       DateTime?
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  lastFailedLogin   DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  assignedRoleId    String?
  assignedRole      Role?     @relation(fields: [assignedRoleId], references: [id], onDelete: SetNull)
  theme             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  referralCode  String?  @unique
  referredById  String?

  activityLogs      ActivityLog[]
  wallet            Wallet?
  kyc               Kyc?
  referrer     User?    @relation("ReferredBy", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers User[]  @relation("ReferredBy")
  referrals    Referral[] @relation("Referrer")
  referred     Referral? @relation("Referred")
  commissions  ReferralCommission[] @relation("UserCommissions")
  indexInvestments IndexInvestment[]
  supportTickets   SupportTicket[]
  sentTransfers     InternalTransfer[] @relation("TransferSender")
  receivedTransfers InternalTransfer[] @relation("TransferReceiver")
}

model Role {
  id            String   @id @default(uuid())
  name          String   @unique
  displayName   String
  description   String?
  color         String   @default("#6366f1")
  theme         String   @default("default")
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages         RolePage[]
  users         User[]
}

model Page {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  category    String   @default("general")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       RolePage[]
}

model RolePage {
  id        String   @id @default(uuid())
  roleId    String
  pageId    String
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([roleId, pageId])
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  bonusBalance Decimal  @default(0) @db.Decimal(18, 2)
  frozen       Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

enum TransferSourceType {
  WALLET
  BONUS
}

enum InternalTransferStatus {
  PENDING
  APPROVED
  REJECTED
}

// A user-to-user transfer within the platform — the sender's amount is
// deducted (into Wallet.frozen) the moment the request is submitted, and
// only reaches the receiver's wallet once an admin approves it. Both
// parties must be KYC-approved at request time.
model InternalTransfer {
  id           String                  @id @default(uuid())
  senderId     String
  receiverId   String
  sourceType   TransferSourceType
  amount       Decimal                 @db.Decimal(18, 2)
  feePercent   Decimal                 @default(0) @db.Decimal(5, 2)
  feeAmount    Decimal                 @default(0) @db.Decimal(18, 2)
  netAmount    Decimal                 @db.Decimal(18, 2)
  status       InternalTransferStatus  @default(PENDING)
  note         String?
  rejectReason String?
  processedBy  String?
  processedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  sender       User @relation("TransferSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User @relation("TransferReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model TransferSettings {
  id          String   @id @default(uuid())
  feePercent  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Flat fee/minimum for regular wallet withdrawals (paid out via UPI), as
// distinct from Index-investment exit fees which are per-tier.
model WalletSettings {
  id                  String   @id @default(uuid())
  minWithdrawal       Decimal  @default(10) @db.Decimal(18, 2)
  withdrawalFeeAmount Decimal  @default(3) @db.Decimal(18, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Transaction {
  id            String            @id @default(uuid())
  walletId      String
  type          TransactionType
  amount        Decimal           @db.Decimal(18, 2)
  feeAmount     Decimal?          @db.Decimal(18, 2)
  payoutAmount  Decimal?          @db.Decimal(18, 2)
  status        TransactionStatus @default(PENDING)
  description   String?
  reference     String?
  // QR-based manual payment flow fields
  screenshotUrl    String?
  transactionId    String?
  upiId            String?
  currency         String?
  processedBy      String?
  processedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  wallet        Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Kyc {
  id                String    @id @default(uuid())
  userId            String    @unique
  status            KycStatus @default(NOT_STARTED)

  fullName          String?
  email             String?
  emailVerified     Boolean   @default(false)
  phone             String?
  countryCode       String?
  phoneVerified     Boolean   @default(false)
  gender            String?
  dateOfBirth       DateTime?
  age               Int?
  country           String?

  // Government ID (Step 1)
  governmentIdType  String?
  documentUrl       String?
  documentFileName  String?
  documentUrlBack   String?
  documentFileNameBack String?

  // Address Proof (Step 2)
  addressProofType  String?
  addressDocUrl     String?
  addressDocFileName String?
  addressDocUrlBack String?
  addressDocFileNameBack String?

  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?
  resubmitAfter     DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  page        String?
  details     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  referredId    String   @unique
  code          String
  status        String   @default("REGISTERED")
  registeredAt  DateTime @default(now())
  kycAt         DateTime?
  depositedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referrer      User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  commissions   ReferralCommission[]

  @@index([referrerId])
  @@index([referredId])
  @@index([code])
}

model ReferralSettings {
  id            String   @id @default(uuid())
  commissionRate Decimal @default(2) @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReferralCommission {
  id            String   @id @default(uuid())
  referralId    String
  userId        String?
  amount        Decimal  @db.Decimal(18, 2)
  percentage    Decimal  @db.Decimal(5, 2)
  status        String   @default("PENDING")
  depositTxId   String?
  source        String   @default("DEPOSIT")
  level         Int      @default(1)
  indexInvestmentId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referral      Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user          User?    @relation("UserCommissions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([referralId])
  @@index([status])
  @@index([source])
}

model IndexTier {
  id                String   @id @default(uuid())
  minAmount         Decimal  @db.Decimal(18, 2)
  maxAmount         Decimal  @db.Decimal(18, 2)
  label             String
  tagline           String?
  imageUrl          String?
  durationMonths    Int      @default(18)
  weeklyReturn      Decimal  @db.Decimal(8, 4)
  monthlyReturn     Decimal  @db.Decimal(8, 4)
  halfYearlyReturn  Decimal  @db.Decimal(8, 4)
  maintenanceFeePercent Decimal @default(5) @db.Decimal(5, 2)
  exitFeePercent    Decimal  @default(2) @db.Decimal(5, 2)
  earlyExitFeePercent Decimal @default(17) @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  investments       IndexInvestment[]

  @@index([isActive])
}

model IndexPrice {
  id            String   @id @default(uuid())
  price         Decimal  @db.Decimal(18, 6)
  changePercent Decimal  @db.Decimal(8, 4) @default(0)
  changeAmount  Decimal  @db.Decimal(18, 6) @default(0)
  dateLabel     String?
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([recordedAt])
}

model IndexSettings {
  id                String   @id @default(uuid())
  maintenanceFeePercent Decimal @default(5) @db.Decimal(5, 2)
  level1Percent     Decimal  @default(2) @db.Decimal(5, 2)
  level2Percent     Decimal  @default(0.5) @db.Decimal(5, 2)
  level3Percent     Decimal  @default(0.5) @db.Decimal(5, 2)
  level4Percent     Decimal  @default(0.5) @db.Decimal(5, 2)
  level5Percent     Decimal  @default(0.5) @db.Decimal(5, 2)
  earlyWithdrawalPercent Decimal @default(17) @db.Decimal(5, 2)
  maturityWithdrawalFee  Decimal @default(2) @db.Decimal(18, 2)

  // Target return the published ORVANTA Index Price chart grows toward.
  // The daily price shown to users wiggles day to day for a realistic look,
  // but is mathematically anchored so the cumulative change over exactly
  // 7 / 30 / 90 days always equals these admin-set figures — never an
  // invented number beyond what admin has published here.
  indexWeeklyReturnPercent    Decimal @default(1.5) @db.Decimal(8, 4)
  indexMonthlyReturnPercent   Decimal @default(6) @db.Decimal(8, 4)
  indexQuarterlyReturnPercent Decimal @default(18) @db.Decimal(8, 4)

  // Minimum total Index investment (across all of a referrer's own
  // investments) required to unlock each referral-income tier. Level 1 opens
  // at referralTierLevel1MinInvestment; levels 2-3 additionally require
  // referralTierLevel123MinInvestment; all 5 levels additionally require
  // referralTierLevel12345MinInvestment. A referrer below a tier's minimum
  // simply doesn't qualify for commission at those levels — their share
  // falls through to the platform wallet like any other unfilled level.
  referralTierLevel1MinInvestment      Decimal @default(200) @db.Decimal(18, 2)
  referralTierLevel123MinInvestment    Decimal @default(1000) @db.Decimal(18, 2)
  referralTierLevel12345MinInvestment  Decimal @default(2000) @db.Decimal(18, 2)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IndexManager {
  id          String   @id @default(uuid())
  name        String
  title       String
  bio         String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// How the Index's pooled capital is actually diversified across asset
// classes (e.g. Forex, Crypto, Metals, CFDs) — admin-published so the
// client dashboard can show real, disclosed allocation instead of an
// invented breakdown. `percent` values are expected to sum to 100 across
// active rows, enforced in the admin UI rather than the database.
model FundAllocation {
  id          String   @id @default(uuid())
  label       String
  percent     Decimal  @db.Decimal(5, 2)
  description String?
  imageUrl    String?
  // Free-form sub-items shown under the category (e.g. "EUR/USD — 10%")
  // as a JSON array of { label, percent } so admin can adjust the detail
  // rows without a schema change.
  details     Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum IndexInvestmentStatus {
  ACTIVE
  MATURED
  CANCELLED
}

model IndexInvestment {
  id          String                 @id @default(uuid())
  userId      String
  tierId      String
  amount      Decimal                @db.Decimal(18, 2)
  feeAmount   Decimal                @default(0) @db.Decimal(18, 2)
  netAmount   Decimal                @default(0) @db.Decimal(18, 2)
  status      IndexInvestmentStatus  @default(ACTIVE)
  activatedAt DateTime               @default(now())
  maturesAt   DateTime?
  withdrawnAt DateTime?
  withdrawalFee   Decimal?           @db.Decimal(18, 2)
  payoutAmount    Decimal?           @db.Decimal(18, 2)
  maturityNotifiedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier        IndexTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
}

enum SupportCategory {
  TECHNICAL
  BILLING
  KYC
  ACCOUNT
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id            String               @id @default(uuid())
  userId        String
  category      SupportCategory
  subject       String
  message       String
  screenshotUrls String[]           @default([])
  status        SupportTicketStatus  @default(OPEN)
  adminNote     String?
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PlatformLedgerType {
  FEE_CREDIT
  WITHDRAWAL
}

enum PlatformWithdrawalStatus {
  PENDING
  COMPLETED
  REJECTED
}

// Singleton row — accumulates the leftover share of the Index maintenance
// fee whenever an investor's referral chain doesn't cover all 5 levels
// (including a chain of zero, i.e. the investor has no referrer at all).
model PlatformWallet {
  id        String   @id @default(uuid())
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger      PlatformLedgerEntry[]
  withdrawals PlatformWithdrawal[]
}

model PlatformLedgerEntry {
  id                String             @id @default(uuid())
  platformWalletId  String
  type              PlatformLedgerType
  amount            Decimal            @db.Decimal(18, 2)
  description       String?
  indexInvestmentId String?
  createdAt         DateTime           @default(now())

  platformWallet    PlatformWallet     @relation(fields: [platformWalletId], references: [id], onDelete: Cascade)

  @@index([platformWalletId])
  @@index([createdAt])
}

model PlatformWithdrawal {
  id               String                   @id @default(uuid())
  platformWalletId String
  amount           Decimal                  @db.Decimal(18, 2)
  status           PlatformWithdrawalStatus @default(PENDING)
  destination      String
  note             String?
  requestedBy      String
  processedBy      String?
  processedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  platformWallet   PlatformWallet           @relation(fields: [platformWalletId], references: [id], onDelete: Cascade)

  @@index([platformWalletId])
  @@index([status])
}
